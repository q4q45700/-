<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.company.dataplatform</groupId>
    <artifactId>platform-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>platform-parent</name>

    <modules>
        <module>platform-base/platform-base-api</module>
        <module>platform-base/platform-base-utils</module>
        <module>platform-base/platform-base-security</module>

        <module>platform-tools/tool-db</module>
        <module>platform-tools/tool-search</module>
        <module>platform-tools/tool-graph</module>

        <module>platform-biz/biz-ingestion</module>
        <module>platform-biz/biz-template</module>
        <module>platform-biz/biz-case</module>

        <module>platform-services/service-gateway</module>
        <module>platform-services/service-ingestion</module>
        <module>platform-services/service-analysis</module>
    </modules>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring.boot.version>3.3.4</spring.boot.version>
        <jackson.version>2.17.2</jackson.version>
        <spring.security.version>6.3.3</spring.security.version>
        <hikari.version>5.1.0</hikari.version>
        <postgres.version>42.7.4</postgres.version>
        <elasticsearch.client.version>8.15.0</elasticsearch.client.version>
        <gremlin.version>3.7.3</gremlin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring.boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
